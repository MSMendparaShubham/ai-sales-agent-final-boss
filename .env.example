# ==============================================================================
# INTENTOS SALES PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Safe, non-sensitive template. DO NOT put production secrets in this file.
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
# Required for all environments.
DATABASE_URL="file:./dev.db"

# Public Branding (Browser accessible)
NEXT_PUBLIC_APP_NAME="IntentOS"
NEXT_PUBLIC_APP_TAGLINE="Turn public buying signals into sales-ready opportunities."

# Public Application Base URL (Required for Twilio webhook callbacks in live mode)
# In development, use your ngrok or Cloudflare tunnel URL (e.g., https://your-subdomain.ngrok-free.app)
APP_URL="http://localhost:3000"

# Operational Mode Toggle:
# true  -> Deterministic demo mode (simulated telephony, local audio, zero external costs)
# false -> Live production mode (requires real Twilio & Gemini Live credentials)
DEMO_MODE="true"

# Environment tier
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Required for session token encryption and CSRF mitigation.
BETTER_AUTH_SECRET="development_secret_do_not_use_in_prod"

# ------------------------------------------------------------------------------
# 3. OFFLINE AI INTELLIGENCE PIPELINE (Lead Analysis & Scoring)
# ------------------------------------------------------------------------------
# Options: "demo" (deterministic local mock) or "ollama" (local LLM)
AI_PROVIDER="demo"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ------------------------------------------------------------------------------
# 4. REALTIME VOICE AI ENGINE ($0 AI COST - GEMINI LIVE ONLY)
# ------------------------------------------------------------------------------
# IntentOS strictly enforces $0 AI cost. Only "gemini" and "demo" are supported.
# Paid voice providers (OpenAI, Anthropic, ElevenLabs, Deepgram) are strictly prohibited.
VOICE_AI_PROVIDER="gemini"

# Required when DEMO_MODE="false" and VOICE_AI_PROVIDER="gemini"
# Get your zero-cost key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Configurable Gemini Live Audio Model
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"

# Configurable Gemini Live Voice persona (e.g. Aoede, Puck, Charon, Fenrir, Kore)
GEMINI_LIVE_VOICE="Aoede"

# ------------------------------------------------------------------------------
# 5. VOICE GATEWAY (Twilio Media Streams <-> Gemini Live Bridge)
# ------------------------------------------------------------------------------
# WebSocket URL for bidirectional telephony audio streaming.
# For local development with tunnel: wss://your-tunnel.ngrok-free.app/voice-gateway
# Default fallback: ws://localhost:8080
VOICE_GATEWAY_URL=""
VOICE_GATEWAY_PORT="8080"

# Optional secret for authenticating WebSocket connections between Twilio & Gateway
VOICE_GATEWAY_INTERNAL_SECRET=""

# ------------------------------------------------------------------------------
# 6. REAL TELEPHONY (Twilio Outbound Calling & SMS)
# ------------------------------------------------------------------------------
# Required only when DEMO_MODE="false" for live phone outreach.
# Canonical Twilio credentials (must be server-only, never exposed to browser)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Configured Twilio phone number in E.164 format (e.g. +14787588866)
TWILIO_PHONE_NUMBER=""

# Optional Twilio webhook validation and transfer settings
TWILIO_WEBHOOK_SIGNING_KEY=""
TWILIO_STATUS_CALLBACK_URL=""
TWILIO_RECORDING_CALLBACK_URL=""
TWILIO_HUMAN_TRANSFER_NUMBER=""

# ------------------------------------------------------------------------------
# 7. ZERO-COST VOICE BUDGET GUARDS & LIMITS
# ------------------------------------------------------------------------------
# Hard limits to prevent runaway voice sessions and protect quota
VOICE_MAX_SESSION_SECONDS="600"       # 10 minutes maximum per phone call
VOICE_DAILY_SESSION_LIMIT="3600"      # 1 hour maximum total voice duration per day
VOICE_MONTHLY_SESSION_LIMIT="36000"   # 10 hours maximum total voice duration per month
VOICE_RECORDING_ENABLED="false"
VOICE_TEST_ALLOWLIST=""

# ------------------------------------------------------------------------------
# 8. CALENDLY HUMAN HANDOFF & MEETING CONCIERGE (Optional)
# ------------------------------------------------------------------------------
# Required only when live Calendly calendar booking is active.
# Defaults to https://calendly.com/intentos-solutions/discovery in demo mode.
CALENDLY_EVENT_TYPE_URL=""
CALENDLY_API_TOKEN=""
CALENDLY_WEBHOOK_SIGNING_KEY=""

# ------------------------------------------------------------------------------
# 9. RAZORPAY PAYMENT GATEWAY (Optional / Billing)
# ------------------------------------------------------------------------------
# Required only when processing real subscription upgrade payments.
# Core AI sales features operate independently of Razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ------------------------------------------------------------------------------
# 10. APOLLO.IO B2B LEAD ENRICHMENT PIPELINE
# ------------------------------------------------------------------------------
# API key from Apollo.io (Settings -> Integrations -> API Keys)
APOLLO_API_KEY="a5ptdDnznTO3Q_7E5fQwZg"
APOLLO_MAX_ENRICHMENTS_PER_RUN="20"